#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)
_WARN_UNREAD=0    # 1 once warn prints, until the human next answers a prompt

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable. A warning printed since
# the last prompt gets a pause first, so the clear never wipes it unread.
_clear() {
  [[ -t 1 ]] || return 0
  (( _WARN_UNREAD )) && pause "Read the warning above? Press Enter."
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; _WARN_UNREAD=1; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  _WARN_UNREAD=0
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  _WARN_UNREAD=0
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's quoting undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"; fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  _WARN_UNREAD=0
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM${e}[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  _WARN_UNREAD=0
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line). Idempotent. Creates ENV_FILE at mode 0600; writes through a symlink
# and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────


# Registers one catalogue workflow on WorkflowHub, or adds a new version to
# its entry, and walks its workflow owner through minting a citable version
# (CONTRIBUTING.md, "9. WorkflowHub"; ADR-0002: one entry per catalogue
# workflow, imported by git from main, type Other, each citable version a
# frozen snapshot of main). The owner runs it on the desktop, from a clone;
# it needs curl and python3 and no credentials, only a browser signed in to
# WorkflowHub as a member of the team.
#
#   bin/workflowhub <slug>             the walkthrough
#   bin/workflowhub --values <slug>    print what it would enter, and stop
#
# Every value comes from workflows/<slug>/: the manifest's name, description,
# tags and owner, the entry script src/run.py, and the entry itself, from the
# newest DOI the page's "Cite this workflow" lists; with none listed it
# registers a new entry. It does every step WorkflowHub documents and leaves
# the owner two clicks, in order and each behind a yes: Register (Update,
# for a new version), which publishes the version and freezes it
# (dev.workflowhub.eu showed both, #196), and Generate a DOI. It reads the
# published entry back between them, and ends with the lines that list the
# new citable version on the page and in CITATION.cff, for the owner's PR.
#
# IRIS_WORKFLOWHUB=https://dev.workflowhub.eu, with IRIS_WORKFLOWHUB_TEAM set
# to a team there, runs it against WorkflowHub's development instance, which
# mints no DOIs, so it stops after Register or Update, once it has read the
# entry back as it would before a DOI. That instance's entries are its own:
# IRIS_WORKFLOWHUB_ENTRY=<entry URL> adds a new version to one.
#
# Answers are kept in $IRIS_WIZARD_ENV (default below, outside the repo), one
# file per workflow and instance, so a re-run offers them back: Enter keeps
# a kept answer, and its yes-or-no questions take y again.
#
# It sits in bin/ with the other desktop tools, so Pages serves it like
# every file; that's harmless, since it holds no credentials and writes
# its answers outside the repo.

refuse() { echo "bin/workflowhub: $1" >&2; exit 2; }
VALUES_ONLY=no
if [[ "${1:-}" == --values ]]; then VALUES_ONLY=yes; shift; fi
[[ $# == 1 ]] || { echo "usage: bin/workflowhub [--values] <slug>" >&2; exit 2; }
SLUG=$1
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
WF=workflows/$SLUG
[[ "$SLUG" != hello-world ]] || refuse "hello-world is onboarding, not a catalogue workflow, so it has no WorkflowHub entry"
[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]*$ && -d "$ROOT/$WF" ]] || refuse "no workflow folder $WF"
for f in form.yml.erb manifest.yml src/run.py index.html; do
  [[ -f "$ROOT/$WF/$f" ]] || refuse "$WF has no $f; only a workflow with a form, an entry script and a page is registered"
done

# manifest_value <key>: one value from the workflow's manifest.yml, a key at
# the top level (name) or one level down (a.b), given on the key's
# line or as a | block under it. It reads only that plain YAML, so it needs
# no YAML library on the owner's desktop; a missing key prints nothing.
manifest_value() {
  python3 -I - "$ROOT/$WF/manifest.yml" "$1" <<'PY'
import re, sys
lines = open(sys.argv[1], encoding="utf-8").read().replace("\r", "").split("\n")
want, parents, i = sys.argv[2], [], 0
while i < len(lines):
    m = re.match(r"( *)([A-Za-z_][\w-]*):(?: +(.*?))? *$", lines[i])
    i += 1
    if not m or lines[i - 1].lstrip().startswith("#"):
        continue
    indent, key, value = len(m[1]), m[2], m[3] or ""
    parents = [(n, k) for n, k in parents if n < indent]
    path = ".".join([k for _, k in parents] + [key])
    if value in ("|", "|-", ">"):
        block = []
        while i < len(lines) and (not lines[i].strip() or len(lines[i]) - len(lines[i].lstrip()) > indent):
            block.append(lines[i]); i += 1
        depth = min((len(b) - len(b.lstrip()) for b in block if b.strip()), default=0)
        value = "\n".join(b[depth:] for b in block).rstrip()
    elif not value:
        parents.append((indent, key))
        continue
    else:
        value = re.sub(r" +#.*$", "", value).strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        value = value.strip("[]")
    if path == want:
        print(value)
        break
PY
}

# owner_field <name|orcid>: the workflow owner's name or ORCID iD from the
# manifest's owner block, read by bin/manifest-owner (#136), which reads that
# block for every tool. The ORCID is empty when unset, so the walkthrough
# asks. An owner block it refuses is refused here, with its reason.
owner_field() { (cd "$ROOT" && bin/manifest-owner "$WF/manifest.yml" "$1"); }
OWNER_PROBLEM=$(cd "$ROOT" && bin/manifest-owner "$WF/manifest.yml" 2>&1) ||
  refuse "$OWNER_PROBLEM; the WorkflowHub entry's creator is the workflow owner in the manifest"

TITLE_NAME=$(manifest_value name)
TAGS=$(manifest_value tags)
BODY=$(manifest_value description)
for k in name description tags; do
  v=TITLE_NAME; [[ $k == description ]] && v=BODY; [[ $k == tags ]] && v=TAGS
  [[ -n "${!v}" ]] || refuse "$WF/manifest.yml has no $k:, which the WorkflowHub entry takes"
done
# The manifest's name, prefixed so it reads on its own in WorkflowHub's search.
TITLE="UNSW HPC Katana - $TITLE_NAME"
OWNER=$(owner_field name)
OWNER_ORCID=$(owner_field orcid)

WH="${IRIS_WORKFLOWHUB:-https://workflowhub.eu}"
WH="${WH%/}"
[[ "$WH" =~ ^https://([a-z0-9-]+\.)?workflowhub\.eu$ ]] ||
  refuse "IRIS_WORKFLOWHUB is $WH; give https://workflowhub.eu, or https://dev.workflowhub.eu to test"
WH_RE="${WH//./\\.}"
PRODUCTION=no; [[ "$WH" == https://workflowhub.eu ]] && PRODUCTION=yes
TEAM_ID="${IRIS_WORKFLOWHUB_TEAM:-472}"
[[ "$TEAM_ID" =~ ^[0-9]+$ ]] || refuse "IRIS_WORKFLOWHUB_TEAM is $TEAM_ID, not a team number"
TEAM_NAME="team $TEAM_ID"
[[ "$PRODUCTION$TEAM_ID" == yes472 ]] && TEAM_NAME="UNSW ResTech"
TEAM_URL=$WH/projects/$TEAM_ID

REPO_URL=https://github.com/unsw-restech/iris
BRANCH=main
MAIN_FILE=$WF/src/run.py
WF_TYPE=Other
LICENCE=Apache-2.0
ORG_CREATOR="UNSW Research Technology Services"
PAGE_URL=https://docs.restech.unsw.edu.au/iris/workflows/$SLUG/
DOI_RE='10\.48546/workflowhub\.workflow\.[0-9]+\.[0-9]+'
# The manifest's description, its own documentation line moved to the end,
# where it follows a pointer to the page's citing rule (README's "Citing
# IRIS" owns that rule; the entry only points at it).
BODY=$(sed '/^Documentation: /d' <<< "$BODY")
BODY="${BODY%"${BODY##*[![:space:]]}"}"
DESCRIPTION="$BODY

IRIS is UNSW Research Technology Services' AI imaging gateway on the Katana cluster. To cite a run, follow \"Cite this workflow\" on the page below, and give the commit in the run's commit.txt.

Documentation: $PAGE_URL"

# The entry: on WorkflowHub itself, the one the page's newest citable version
# belongs to; on the development instance, only one named for it.
LISTED_DOI=""
ENTRY_URL="${IRIS_WORKFLOWHUB_ENTRY:-}"
ENTRY_FROM="IRIS_WORKFLOWHUB_ENTRY"
if [[ -n "$ENTRY_URL" ]]; then
  # An entry on the other instance most often means IRIS_WORKFLOWHUB never
  # reached this run: it sat on a line of its own, which sets it for nothing
  # (#196's dev run, twice). So the refusal gives the one line to paste. A
  # team number belongs to one site: workflowhub.eu's line takes the default,
  # and the development instance's a set one, or N to replace.
  if [[ "$ENTRY_URL" =~ ^(https://([a-z0-9-]+\.)?workflowhub\.eu)/workflows/[0-9]+/?$ &&
        "${BASH_REMATCH[1]}" != "$WH" ]]; then
    OTHER_WH="${BASH_REMATCH[1]}" OTHER_TEAM="" TEAM_HINT=""
    if [[ "$OTHER_WH" != https://workflowhub.eu ]]; then
      OTHER_TEAM="IRIS_WORKFLOWHUB_TEAM=${IRIS_WORKFLOWHUB_TEAM:-N} "
      [[ -n "${IRIS_WORKFLOWHUB_TEAM:-}" ]] ||
        TEAM_HINT=", N being your team's number there, from $OTHER_WH/projects/N"
    fi
    refuse "IRIS_WORKFLOWHUB_ENTRY is on $OTHER_WH, but this run is on $WH: IRIS_WORKFLOWHUB didn't reach the command, or names the other site. A NAME=value on a line of its own sets it for nothing, so paste this as one line$TEAM_HINT:
  IRIS_WORKFLOWHUB=$OTHER_WH ${OTHER_TEAM}IRIS_WORKFLOWHUB_ENTRY=$ENTRY_URL bin/workflowhub $SLUG"
  fi
  [[ "$ENTRY_URL" =~ ^$WH_RE/workflows/[0-9]+/?$ ]] ||
    refuse "IRIS_WORKFLOWHUB_ENTRY is $ENTRY_URL, not an entry on $WH ($WH/workflows/<number>)"
  ENTRY_URL="${ENTRY_URL%/}"
elif [[ $PRODUCTION == yes ]]; then
  LISTED_DOI=$(tr -d '\r' < "$ROOT/$WF/index.html" |
    awk '/ id="cite"/ { c = 1 } c && /<\/details>/ { c = 0 } c' | grep -oE "$DOI_RE" | head -n1 || true)
  if [[ -n "$LISTED_DOI" ]]; then
    ENTRY_URL=${LISTED_DOI#10.48546/workflowhub.workflow.}
    ENTRY_URL=$WH/workflows/${ENTRY_URL%%.*}
    ENTRY_FROM="$LISTED_DOI on the page"
  fi
fi

if [[ $VALUES_ONLY == yes ]]; then
  printf '%s\n' "Instance: $WH" "Team: $TEAM_URL ($TEAM_NAME)" "Repository: $REPO_URL" "Branch: $BRANCH" \
    "Main workflow file: $MAIN_FILE" "Workflow type: $WF_TYPE" "Licence: $LICENCE" "Title: $TITLE" "Tags: $TAGS"
  echo "Creator: $OWNER, ORCID ${OWNER_ORCID:-asked for}"
  echo "Creator: $ORG_CREATOR"
  if [[ -n "$ENTRY_URL" ]]; then echo "Entry: $ENTRY_URL (from $ENTRY_FROM), so it adds a new version"
  else echo "Entry: none yet, so it registers a new one"; fi
  printf 'Description:\n%s\n' "$DESCRIPTION"
  exit 0
fi

ENV_FILE="${IRIS_WIZARD_ENV:-$HOME/.config/iris/workflowhub-$SLUG.env}"
[[ $PRODUCTION == yes || -n "${IRIS_WIZARD_ENV:-}" ]] || ENV_FILE="$HOME/.config/iris/workflowhub-$SLUG@${WH#https://}.env"
mkdir -p "$(dirname "$ENV_FILE")"

# paste_block "label" "text" prints text flush left between rules, so it
# copies cleanly into a WorkflowHub field.
paste_block() {
  printf '\n  %s%s:%s\n%s----%s\n%s\n%s----%s\n' "$BOLD" "$1" "$RESET" "$DIM" "$RESET" "$2" "$DIM" "$RESET"
}

# stop_here "why" ends the run cleanly at a gate the workflow owner declined.
stop_here() {
  printf '\n'
  warn "$1"
  note "Nothing after this point was done. Re-run the walkthrough when ready; your answers are kept in $ENV_FILE."
  exit 0
}

# wh_read <field> prints one field of the entry at $WH_ENTRY_URL from
# WorkflowHub's public JSON API: title, licence, or the newest version's
# commit or doi. Prints nothing until the entry is public, or if the API
# can't be reached, so a caller falls back to asking.
wh_read() {
  { curl -fsS -H 'Accept: application/vnd.api+json' "$WH_ENTRY_URL" | python3 -I -c '
import json, sys
attrs = json.load(sys.stdin)["data"]["attributes"]
newest = max(attrs.get("versions") or [{}], key=lambda v: v.get("version", 0))
print({"title": attrs.get("title"), "licence": attrs.get("license"),
       "commit": newest.get("commit"), "doi": newest.get("doi")}[sys.argv[1]] or "")' "$1"; } 2>/dev/null || true
}

ok() { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }

# expect_field <field> <wanted> warns, and fails, if the live entry's field
# differs.
expect_field() {
  local got; got=$(wh_read "$1")
  if [[ -z "$got" ]]; then warn "couldn't read the entry's $1 from WorkflowHub; check it by eye"
  elif [[ "$got" != "$2" ]]; then warn "the entry's $1 is \"$got\", not \"$2\""; return 1
  else ok "$1: $got"; fi
}

# read_back [<when>]: checks the published entry's title, licence and
# newest version's commit, from its API, against what was entered, and
# fails if any differ. On dev.workflowhub.eu a title edited after Freeze
# showed on the frozen version too (#196, #203), so a different title or
# licence is told to fix it, <when> (such as "before the DOI"). A commit
# can't be edited, so a different one is told what to check.
read_back() {
  local metadata=yes commit=yes
  say "What the published entry says:"
  expect_field title "$TITLE" || metadata=no
  expect_field licence "$LICENCE" || metadata=no
  [[ -z "${WH_IMPORT_COMMIT:-}" ]] || expect_field commit "$WH_IMPORT_COMMIT" || commit=no
  [[ $metadata == yes ]] || warn "fix it with Actions → Edit Workflow${1:+ $1}, or the value in $WF/manifest.yml"
  [[ $commit == yes ]] ||
    warn "a version's commit can't be edited: check its git details show $REPO_URL, $BRANCH (which may have moved since it was read); a citable version lists the commit WorkflowHub shows"
  [[ "$metadata$commit" == yesyes ]]
}

ORCID_RE='^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$'
# The button that publishes: Register for a new entry, Update for a new
# version of one (dev.workflowhub.eu, #196).
SUBMIT=Register; [[ -z "$ENTRY_URL" ]] || SUBMIT=Update
if [[ $PRODUCTION == yes ]]; then TOTAL_STAGES=8; else TOTAL_STAGES=6; fi
if [[ -n "$ENTRY_URL" ]]; then banner "Add a citable version of $SLUG on WorkflowHub"
else banner "Register $SLUG on WorkflowHub"; fi

# ──────────────────────────────────────────────────────────────────────────
stage "Before you start"
say "If no browser opens on the machine you're reading this on, click the printed URLs."
say "To copy text from here, select it, then any of:"
step "right-click → Copy"
step "Edit → Copy, in the menu bar"
step "your terminal's copy key, often Ctrl+Shift+C"
note "Ctrl+C with nothing selected stops the walkthrough. If it does, re-run it: it"
note "offers back every answer you gave."
printf '\n'
say "This walkthrough does every step with you. Your clicks, in order:"
say "  1. $SUBMIT, which makes the version public and freezes it."
if [[ $PRODUCTION == yes ]]; then
  say "  2. Generate a DOI, which is permanent."
  say "It stops for a yes before each one."
else
  say "It stops for a yes before it. On $WH, which mints no DOIs, it ends after $SUBMIT."
fi
pause "Got it? Press Enter."

# ──────────────────────────────────────────────────────────────────────────
stage "Sign in to WorkflowHub, and check you are in $TEAM_NAME"
printf "  %s%sDon't skip this: the stages after it need you signed in and in the team.%s\n" "$BOLD" "$YELLOW" "$RESET"
open_url "$TEAM_URL"
step "Sign in to WorkflowHub (top right) if you aren't already."
step "On the $TEAM_NAME page, check you're listed under its people."
note "Only the team's members can register into it. If you aren't listed, click Request"
note "Membership (top right of the team page), type your organisation and pick it from"
note "the list, or keep typing its full name to pick it from ROR (UNSW Sydney's ROR ID is"
note "03r8z3t63), add your department, Submit, and wait for approval."
printf '\n'
confirm "Signed in and listed in $TEAM_NAME?" ||
  stop_here "Request Membership on $TEAM_URL, and re-run once you're listed."
printf '\n'
# The workflow owner's name and ORCID iD go in the creators list. The
# manifest always gives the name; the ORCID is asked for when it lacks one.
if ! [[ "${OWNER_ORCID:-}" =~ $ORCID_RE ]]; then
  printf '  %s%sOWNER ORCID NEEDED%s\n' "$BOLD" "$YELLOW" "$RESET"
  say "Your ORCID iD goes in the creators list, and belongs in $WF/manifest.yml."
  say "Find it at https://orcid.org/my-orcid or on your WorkflowHub profile."
  OWNER_ORCID=""
  until [[ "${OWNER_ORCID:-}" =~ $ORCID_RE ]]; do
    [[ -n "${OWNER_ORCID:-}" ]] && warn "that isn't an ORCID iD like 0000-0002-1825-0097"
    ask OWNER_ORCID ">>> ENTER YOUR ORCID iD (0000-0000-0000-0000):"
    OWNER_ORCID="${OWNER_ORCID#https://orcid.org/}"
  done
  write_env OWNER_ORCID "$OWNER_ORCID"
fi

# ──────────────────────────────────────────────────────────────────────────
if [[ -n "$ENTRY_URL" ]]; then stage "Add a new version from git"; else stage "Import the repo from git"; fi
# The commit main is at when imported, to compare with what the entry shows.
WH_IMPORT_COMMIT=$(_existing WH_IMPORT_COMMIT || true)
if [[ -z "$WH_IMPORT_COMMIT" ]] || ! confirm "Already imported, at ${WH_IMPORT_COMMIT:0:12}? No reads $BRANCH again"; then
  WH_IMPORT_COMMIT=$(git ls-remote "$REPO_URL" "refs/heads/$BRANCH" 2>/dev/null | cut -f1 || true)
fi
if [[ -n "$WH_IMPORT_COMMIT" ]]; then
  write_env WH_IMPORT_COMMIT "$WH_IMPORT_COMMIT"
  note "$BRANCH is at $WH_IMPORT_COMMIT; WorkflowHub imports the latest commit."
else
  warn "couldn't read $BRANCH's commit from $REPO_URL; note it from GitHub instead"
fi
if [[ -n "$ENTRY_URL" ]]; then
  open_url "$ENTRY_URL"
  step "Actions → New Version."
  step "It asks for the Git repository URL: set it to this one, then click Continue."
  paste_block "Git repository URL" "$REPO_URL"
  paste_block "Branch (not a release tag)" "$BRANCH"
  step "Click Register."
  note "It skips the main workflow file, going straight to the New Workflow Version page."
  pause "On the New Workflow Version page? Press Enter."
else
  open_url "$WH/workflows/new"
  step "If that isn't the new-workflow page: Create (top menu) → Workflow."
  step "In the menu on the left, choose Import Git Repository."
  paste_block "Git repository URL" "$REPO_URL"
  step "Click Register."
  paste_block "Branch (not a release tag)" "$BRANCH"
  step "Click Register again."
  paste_block "Main workflow file (pick it from the list)" "$MAIN_FILE"
  step "Leave Abstract CWL and Diagram empty."
  step "Workflow type: $WF_TYPE"
  note "WorkflowHub then lists the entry as an Unrecognized workflow type; that's $WF_TYPE."
  step "Click Continue."
  pause "On the metadata step? Press Enter."
fi

# ──────────────────────────────────────────────────────────────────────────
stage "Title and description"
say "Set each field on this page to the text below, replacing whatever it holds."
paste_block "Title" "$TITLE"
paste_block "Description" "$DESCRIPTION"
pause "Both set? Press Enter."

# ──────────────────────────────────────────────────────────────────────────
stage "Team, licence, sharing, tags and creators, then $SUBMIT"
say "Set each of these to the value below, replacing whatever it holds."
step "Teams: $TEAM_NAME (team $TEAM_ID)."
step "Licence: $LICENCE (Apache License 2.0)."
step "Sharing: give $TEAM_NAME manage rights, so the maintainer can fix any team entry."
note "Leave public access as offered."
paste_block "Tags" "$TAGS"
step "Creators, in this order:"
say "  1. $OWNER, ORCID $OWNER_ORCID: pick your WorkflowHub profile, and"
say "     check it shows that ORCID (add it to your profile if not)."
say "  2. Your co-authors, with ORCIDs where they have them."
say "  3. $ORG_CREATOR: if there's no organisation creator, put it in the"
say "     free-text other-creators field."
printf '\n'
printf '  %s%sYour click 1: %s, which publishes it.%s\n' "$BOLD" "$RED" "$SUBMIT" "$RESET"
say "$SUBMIT previews the sharing: Public Visibility, all visitors can view it."
say "It may add that the team's gatekeepers are emailed to approve publishing;"
say "a team with none publishes it at once."
say "OK makes the version public, and frozen: its files and metadata are what a"
say "DOI will point at."
confirm "Check every field above once more. $SUBMIT and publish it now?" ||
  stop_here "Stopped before $SUBMIT."
step "Click $SUBMIT, then OK on the sharing preview."
printf '\n'
if [[ -n "$ENTRY_URL" ]]; then
  WH_ENTRY_URL=$ENTRY_URL
  pause "Updated? Press Enter."
else
  WH_ENTRY_URL=$(_existing WH_ENTRY_URL || true)
  [[ "${WH_ENTRY_URL:-}" =~ ^$WH_RE/workflows/[0-9]+ ]] || WH_ENTRY_URL=""
  until [[ "${WH_ENTRY_URL:-}" =~ ^$WH_RE/workflows/[0-9]+$ ]]; do
    [[ -n "${WH_ENTRY_URL:-}" ]] && warn "expected $WH/workflows/<number>"
    ask WH_ENTRY_URL "Paste the new entry's URL:"
    WH_ENTRY_URL="${WH_ENTRY_URL%%\?*}"
    WH_ENTRY_URL="${WH_ENTRY_URL%/}"
  done
fi
write_env WH_ENTRY_URL "$WH_ENTRY_URL"
ENTRY_ID=${WH_ENTRY_URL##*/}

# ──────────────────────────────────────────────────────────────────────────
stage "Check the published entry"
open_url "$WH_ENTRY_URL"
step "Check Description, Creators (ORCID on yours) and Team by eye."
step "Version History should show the new version as Frozen${WH_IMPORT_COMMIT:+, at $BRANCH ${WH_IMPORT_COMMIT:0:7}}."
# dev.workflowhub.eu froze the version on Register and Update (#196); a DOI needs it
# frozen, so workflowhub.eu stops here if it didn't.
if ! confirm "Does Version History show it Frozen?"; then
  [[ $PRODUCTION == yes ]] &&
    stop_here "Stopped before the DOI: a DOI points at a frozen version. Tell the IRIS maintainer what Version History shows."
  warn "not frozen on $SUBMIT: tell the IRIS maintainer what Version History shows"
fi
printf '\n'
# Published, the entry is public, so the API shows what a DOI would carry.
if [[ $PRODUCTION == yes ]]; then
  read_back "before the DOI" || true
  pause "Checked? Press Enter."
else
  if read_back; then
    printf '\n'
    ok "Done up to $SUBMIT on $WH: $WH_ENTRY_URL"
  else
    printf '\n'
    warn "Published on $WH, but the entry differs from what this walkthrough expected: $WH_ENTRY_URL"
  fi
  note "DOIs mint only on https://workflowhub.eu, so the walkthrough ends here."
  # finish clears the screen, so the read-back stays up until Enter.
  pause "Press Enter to finish."
  finish
  exit 0
fi

# ──────────────────────────────────────────────────────────────────────────
stage "Generate a DOI"
printf '  %s%sYour click 2: Generate a DOI. One-way door.%s\n' "$BOLD" "$RED" "$RESET"
say "A DOI is permanent: DataCite keeps it, and this snapshot's metadata, for good."
step "On the frozen version, in the Citation panel, Generate a DOI."
step "It reminds you to review the metadata, then asks you to confirm."
printf '\n'
confirm "Generate the DOI for this frozen snapshot now? It can't be undone" ||
  stop_here "Stopped before Generate a DOI."
printf '\n'
# Read from the entry; a pasted DOI covers an API that can't be reached.
# It must be this entry's, and not the citable version already listed.
WH_DOI=$(wh_read doi)
until [[ "${WH_DOI:-}" =~ ^10\.48546/workflowhub\.workflow\.$ENTRY_ID\.[0-9]+$ && "$WH_DOI" != "$LISTED_DOI" ]]; do
  [[ -n "${WH_DOI:-}" ]] && warn "expected a new DOI of entry $ENTRY_ID, like 10.48546/workflowhub.workflow.$ENTRY_ID.1"
  ask WH_DOI "No new DOI read from WorkflowHub yet. Paste it, or press Enter to read again:" || true
  WH_DOI="${WH_DOI#https://doi.org/}"
  [[ -n "$WH_DOI" ]] || WH_DOI=$(wh_read doi)
done
ok "DOI: $WH_DOI"
write_env WH_DOI "$WH_DOI"
open_url "https://doi.org/$WH_DOI"
note "It should resolve to the entry; a new DOI can take a few minutes."

# ──────────────────────────────────────────────────────────────────────────
stage "List the citable version"
WH_COMMIT=$(wh_read commit)
[[ -n "$WH_COMMIT" ]] || WH_COMMIT=${WH_IMPORT_COMMIT:-}
until [[ "${WH_COMMIT:-}" =~ ^[0-9a-f]{7,40}$ ]]; do
  ask WH_COMMIT "Paste the commit the frozen version shows:"
done
SHORT=${WH_COMMIT:0:7}
TODAY=$(date +%F)
say "Open a PR adding this citable version, by DOI, date and commit, never a version number:"
paste_block "In $WF/index.html, the first line of Cite this workflow's list (drop \"No citable version yet\" if it's there)" \
  "      <li><a href=\"https://doi.org/$WH_DOI\" target=\"_blank\">$WH_DOI</a> · $TODAY · commit <code>$SHORT</code></li>"
paste_block "In CITATION.cff's identifiers, above $SLUG's older DOIs" \
  "  - type: doi
    value: $WH_DOI
    description: \"$SLUG's citable version of $TODAY, commit $SHORT\""
note "bin/check fails the PR unless the page and CITATION.cff list the same DOIs."
pause "Copied both? Press Enter."

finish
