#!/bin/bash
# Show what moving the two checkouts of the IRIS fork of OpenComposer on
# Katana, the IRIS instance's and the test instance's, to the fork's main
# would deploy, then deploy exactly that. Both must run one fork commit,
# so they move together or not at all.
#
#   bin/ocpull                 list the commits and files a move would bring each
#   bin/ocpull --apply <sha>   move both checkouts to <sha>, on the fork's main
#
# The listing ends with the --apply line for the fork's main tip. Quote
# every commit it lists verbatim in the go-ahead request, naming both
# checkouts' paths; --apply then deploys that commit even if the fork's
# main has moved since. It checks both checkouts before moving either, and
# refuses a commit off the fork's main or behind a checkout, a checkout
# with uncommitted changes, and a move that changes a file a checkout
# keeps its own copy of (manifest.yml, by skip-worktree), naming every
# problem in both and saying how to take such a change by hand
# (bin/ocpull-checkouts.sh). Both end by listing what a pilot tester can't
# read in the checkouts (bin/pilot-readable.py), and --apply exits 1 if
# anything is listed, since the deploy has happened. --apply exits 1 too,
# after the deploy, if lib/tests/form_helper.rb's header names a commit
# other than <sha>, since the helper then renders as a commit the
# checkouts no longer run. The listing warns of that first, just before
# its --apply line, when the header names a commit other than that line's,
# so the helper's bump goes in before bin/check and bin/katana-test run
# rather than after the deploy (#179's retro).
#
# The IRIS maintainer's dev install, a third checkout of the fork in their
# home folder (lib/katana.sh), stays on the instances' commit too, but
# ocpull never moves it (#159, #162). The listing names its path and the
# commit it is on, and says when that is behind the --apply line's, or
# that it isn't there. --apply then ends, once it has deployed, with the
# line that moves it to <sha> when it is behind <sha>, for the session to
# run as its own command: it fetches the fork and moves the install, and
# refuses, saying why, one with uncommitted changes or a file it keeps its
# own copy of (skip-worktree), which the move could overwrite, as --apply
# refuses such a checkout. An install ahead of <sha> or off the fork's
# main gets no line, since a move there would go backwards or off the
# fork's main: both name its commit and send it to the IRIS maintainer
# (#179's retro).
# Over `ssh katana`.

# shellcheck source=lib/katana.sh
. "$(dirname "$(readlink -f "$0")")/../lib/katana.sh" || exit 2
checkouts=("$IRIS_INSTANCE_CHECKOUT" "$IRIS_TEST_INSTANCE_CHECKOUT")
# The form test helper renders as the fork commit its header names, the
# one the checkouts run; nothing else in the repo records that commit.
helper="$(dirname "$(readlink -f "$0")")/../lib/tests/form_helper.rb"
usage() { echo "usage: bin/ocpull [--apply <sha>]" >&2; exit 2; }
# read_helper_commit <sha>: sets helper_commit to the commit the helper's
# header names, and passes if that is <sha>, in either's length.
read_helper_commit() {
    helper_commit=$(sed -nE 's/^# ([0-9a-f]{7,40}), the commit bin\/ocpull keeps .*/\1/p' "$helper")
    [ -n "$helper_commit" ] && [[ "$1" == "$helper_commit"* || "$helper_commit" == "$1"* ]]
}
# remote <mode> [<arg>]: bin/ocpull-checkouts.sh on Katana, over both checkouts.
remote() {
    ssh katana bash -s -- "$@" "${checkouts[@]}" < "$(dirname "$0")/ocpull-checkouts.sh"
}
# The dev install as Katana's shell names it, in the IRIS maintainer's home.
# shellcheck disable=SC2088  # the ~ is for Katana's shell, in the printed line
dev_path="~/$IRIS_DEV_INSTALL"
# dev_install <rev>: where the dev install is against <rev> in the IRIS
# instance's checkout, as "missing" or "<state> <hash> <subject>"
# (bin/ocpull-checkouts.sh's dev).
dev_install() {
    ssh katana bash -s -- dev "$IRIS_DEV_INSTALL" "$1" "$IRIS_INSTANCE_CHECKOUT" < "$(dirname "$0")/ocpull-checkouts.sh"
}
# readable: lists what a pilot tester can't read in either checkout; fails
# 1 if anything, 2 if it can't tell (bin/pilot-readable.py).
readable() {
    local c rc=0
    for c in "${checkouts[@]}"; do
        ssh katana python3 - "$c" < "$(dirname "$0")/pilot-readable.py"
        case $? in 0) ;; 1) [ $rc = 2 ] || rc=1 ;; *) rc=2 ;; esac
    done
    return $rc
}

if [ $# -eq 0 ]; then
    # Held back so the helper's warning goes just before the --apply line.
    listing=$(remote list) || { rc=$?; [ -z "$listing" ] || printf '%s\n' "$listing"; exit $rc; }
    printf '%s\n' "${listing%$'\n'*}"
    tip=${listing##* }
    dev=$(dev_install origin/main)
    case $dev in
        missing) echo "Dev install $dev_path: not there, so nothing moves it." ;;
        on\ *) echo "Dev install $dev_path: at ${dev#* }, already on $tip." ;;
        behind\ *) echo "Dev install $dev_path: at ${dev#* }, behind $tip; --apply ends with the line that moves it there too." ;;
        other\ *) echo "Dev install $dev_path: at ${dev#* }, ahead of $tip or off the fork's main; ask the IRIS maintainer where it goes." ;;
        *) echo "ocpull: couldn't tell which commit the dev install $dev_path is on." >&2 ;;
    esac
    echo
    read_helper_commit "$tip" ||
        echo "ocpull: lib/tests/form_helper.rb renders as ${helper_commit:-no commit its header names}; bring it, and its header's commit, to $tip, and commit that before pushing, since --apply exits 1 after the deploy until it does."
    printf '%s\n' "${listing##*$'\n'}"
    out=$(readable)
    case $? in
        0) ;;
        1) printf '\nPilot testers already can'"'"'t read these in the checkouts:\n%s\n' "$out" ;;
        *) printf '\nCouldn'"'"'t check what pilot testers can read in the checkouts:\n%s\n' "$out" ;;
    esac
elif [ $# -eq 2 ] && [ "$1" = --apply ] && [[ "$2" =~ ^[0-9a-f]{7,40}$ ]]; then
    remote apply "$2" || exit
    rc=0
    if ! read_helper_commit "$2"; then
        echo "ocpull: deployed, but lib/tests/form_helper.rb still renders as ${helper_commit:-no commit its header names}; bring it, and its header's commit, to $2." >&2
        rc=1
    fi
    readable
    case $? in
        0) ;;
        1) echo "ocpull: deployed, but pilot testers can't read the paths above; fix their ACLs." >&2; rc=1 ;;
        *) echo "ocpull: deployed, but couldn't check what pilot testers can read in the checkouts." >&2; rc=1 ;;
    esac
    # Last, so the session finds it on the final line.
    dev=$(dev_install HEAD)
    case $dev in
        missing | on\ *) ;;
        behind\ *)
            echo "The dev install $dev_path is at ${dev#* }. To move it to $2 too, refusing if it has uncommitted changes or keeps its own copy of a file, run:"
            echo "ssh katana 'cd $dev_path && { git diff --quiet HEAD && [ -z \"\$(git ls-files -v | grep \"^S\")\" ] || { echo \"ocpull: $dev_path has uncommitted changes or keeps its own copy of a file (skip-worktree), so nothing moved it; move it by hand.\" >&2; exit 1; }; } && git fetch -q origin && git checkout -q --detach $2'" ;;
        other\ *) echo "The dev install $dev_path is at ${dev#* }, ahead of $2 or off the fork's main, so nothing here moves it; ask the IRIS maintainer where it goes." ;;
        *) echo "ocpull: couldn't tell which commit the dev install $dev_path is on; move it to $2 by hand if it isn't there." >&2 ;;
    esac
    exit $rc
else
    usage
fi
