#!/bin/bash
# Lists every script run by path that git's index doesn't hold as 100755,
# one path a line, and nothing when all are. An untracked one is listed
# too, so a run before the first git add catches it: git add -N records
# it as 100644 on the Windows mount, and #187's second full bin/check
# failed on just that. core.fileMode is off there, so chmod alone records
# nothing; set the bit with
#   git update-index --chmod=+x <path>
# after git add -N <path> for an untracked one.
# The one list of such scripts: bin/check fails any it prints, and
# .githooks/pre-commit refuses a commit while it prints any. Run from
# anywhere in the clone.
#
#   bin/exec-bits

cd "$(git rev-parse --show-toplevel)" || exit 2
scripts=(bin 'envs/*.sh' 'tests/bin/test_*.sh'
    .githooks/commit-msg .githooks/pre-commit .githooks/pre-push)
git ls-files -s -- "${scripts[@]}" | awk '$1 != "100755" { print $4 }'
git ls-files --others --exclude-standard -- "${scripts[@]}"
