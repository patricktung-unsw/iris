#!/bin/bash
# Refuses a push to main, the public deploy, of a commit this clone hasn't
# checked as it stands:
#   - a full bin/check must have passed on its tree (bin/check-passed), so
#     a branch merged with a newer main is checked as the commit main
#     becomes, not as each side was before the merge;
#   - if it changes the files bin/katana-test tests (its header lists
#     them), a passing bin/katana-test must have tested them exactly as the
#     commit holds them (bin/katana-test --tested);
#   - its lib/katana.sh's digest map, and that of each workflow's library
#     copy of it, workflows/<slug>/lib/katana.sh (#256), must name no
#     workflow author's container, ghcr.io/<login>/iris-env@sha256:<hex>,
#     as this clone's lib/katana.sh's iris_is_author_env knows one, which
#     a PR may carry but main never does: bin/review-batch copies it into
#     IRIS's package and pins its digest alone in each before the push.
#     Nothing lets this one through;
#   - a bin/syspull listing must have run in this clone against the main
#     this push replaces, since the last deploy (bin/syspull --listed),
#     since the push request quotes that listing as the system clone's
#     go-ahead (AGENTS.md's Deploying). It can't tell whether the request
#     quoted it, only that one ran.
# The dev clone pulls main next. Pushes to any other branch go through, so
# CI can run on unchecked work.
#
# IRIS_UNCHECKED=<reason> lets the push through without the first,
# IRIS_KATANA_UNTESTED=<reason> without the second and
# IRIS_NO_SYSPULL=<reason> without the listing, naming the reason, for a
# change the IRIS maintainer has agreed to ship that way.
# Turn it on once per clone: git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"
check_passed="$root/bin/check-passed"
katana_test="$root/bin/katana-test"
syspull="$root/bin/syspull"
zero=0000000000000000000000000000000000000000
status=0
# iris_is_author_env, the one test of an author's container.
# shellcheck source=lib/katana.sh
. <(tr -d '\r' < "$root/lib/katana.sh" 2> /dev/null)
declare -F iris_is_author_env > /dev/null ||
    iris_is_author_env() { [[ "$1" == ghcr.io/* ]]; }  # no lib/katana.sh: refuse any full container name
while read -r _ local_sha remote_ref remote_sha; do
    [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != "$zero" ] || continue

    named=""
    while IFS= read -r file; do
        authors=""
        while IFS=$'\t' read -r version value; do
            ! iris_is_author_env "$value" || authors+="${authors:+$'\n'}$version"
        done < <(git show "$local_sha:$file" 2> /dev/null | tr -d '\r' |
            sed -nE 's|^    \[([^]]+)\]=(\S+)$|\1\t\2|p')
        [ -n "$authors" ] || continue
        where="digest map"
        [ "$file" = lib/katana.sh ] || where="library copy $file's digest map"
        echo "pre-push: ${local_sha:0:7}'s $where names a workflow author's container for ${authors//$'\n'/, }." >&2
        named=1
    done < <(echo lib/katana.sh
        git ls-tree -r --name-only "$local_sha" -- workflows 2> /dev/null | command grep -E '^workflows/[^/]+/lib/katana\.sh$')
    if [ -n "$named" ]; then
        echo "  bin/review-batch copies it into IRIS's package and pins its digest alone, in lib/katana.sh and each library copy; push the commit its --apply makes." >&2
        status=1
    fi

    if [ -x "$check_passed" ] && ! "$check_passed" "$local_sha"; then
        if [ -n "$IRIS_UNCHECKED" ]; then
            echo "pre-push: ${local_sha:0:7} goes to main without a full bin/check pass: $IRIS_UNCHECKED" >&2
        else
            echo "pre-push: no full bin/check in this clone passed on ${local_sha:0:7}'s files." >&2
            echo "  Run bin/check with that commit checked out (again after merging main), or set IRIS_UNCHECKED=<reason> once the IRIS maintainer agrees." >&2
            status=1
        fi
    fi

    # main's first commit has no system clone to list against.
    if [ -x "$syspull" ] && [ "$remote_sha" != "$zero" ] && ! "$syspull" --listed "$remote_sha"; then
        if [ -n "$IRIS_NO_SYSPULL" ]; then
            echo "pre-push: ${local_sha:0:7} goes to main with no bin/syspull listing since main was ${remote_sha:0:7}: $IRIS_NO_SYSPULL" >&2
        else
            echo "pre-push: no bin/syspull listing in this clone since main was ${remote_sha:0:7}." >&2
            echo "  Run bin/syspull and quote the system clone's path and commits in the push request, or set IRIS_NO_SYSPULL=<reason> once the IRIS maintainer agrees." >&2
            status=1
        fi
    fi

    [ -x "$katana_test" ] || continue
    # main's commit as the base: tested files it already holds need no run.
    base=""
    [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null && base="$remote_sha"
    "$katana_test" --tested "$local_sha" ${base:+"$base"}
    case $? in
        0) continue ;;
        2) echo "pre-push: this checkout's bin/katana-test has no --tested; push from a checkout that has it (since 1182a53)." >&2
           status=1; continue ;;
    esac
    if [ -n "$IRIS_KATANA_UNTESTED" ]; then
        echo "pre-push: ${local_sha:0:7} goes to main untested on Katana: $IRIS_KATANA_UNTESTED" >&2
        continue
    fi
    echo "pre-push: ${local_sha:0:7} changes what bin/katana-test tests, and no passing bin/katana-test in this clone tested it." >&2
    echo "  Run bin/katana-test with that commit checked out, or set IRIS_KATANA_UNTESTED=<reason> once the IRIS maintainer agrees." >&2
    status=1
done
exit $status
