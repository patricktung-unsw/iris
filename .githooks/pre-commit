#!/bin/bash
# Refuses a commit while git's index holds a script run by path without its
# executable bit (bin/exec-bits lists them), naming each and the command
# that sets it, since bin/check fails it otherwise only on a full run.
# Turn it on once per clone: git config core.hooksPath .githooks

# bin/exec-bits beside these hooks, so a repo whose core.hooksPath points
# here checks its own index with it, as the conflict-list test's fixture does.
exec_bits="$(dirname "$0")/../bin/exec-bits"
if ! missing="$("$exec_bits")"; then
    echo "pre-commit: bin/exec-bits failed, so the executable bits weren't checked; fix it, or commit with --no-verify once" >&2
    exit 1
fi
[ -z "$missing" ] && exit 0
echo "pre-commit: scripts run by path without the executable bit in git's index:" >&2
while IFS= read -r f; do
    echo "  git update-index --chmod=+x $f" >&2
done <<< "$missing"
exit 1
